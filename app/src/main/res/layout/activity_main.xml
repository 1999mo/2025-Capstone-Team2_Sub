<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 일반 모드 레이아웃 -->
    <LinearLayout
        android:id="@+id/layout_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EOG 상태 대기중"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EOG 장치 연결하기"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/direction_check_start_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="방향 측정 시작"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/direction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="방향 측정 대기 중"
            android:textSize="24sp"
            android:layout_centerInParent="true"/>

        <Button
            android:id="@+id/data_collection_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="데이터 수집 시작"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />
    </LinearLayout>

    <!-- 데이터 수집 모드 레이아웃 (초기에는 숨김) -->
    <LinearLayout
        android:id="@+id/layout_datacollect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp">

        <!-- 왼쪽 3×3 그리드 -->
        <GridLayout
            android:id="@+id/grid_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:rowCount="3"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <View
                android:id="@+id/section_left_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_left_9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />
        </GridLayout>

        <!-- 오른쪽 3×3 그리드 -->
        <GridLayout
            android:id="@+id/grid_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:rowCount="3"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <View
                android:id="@+id/section_right_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_6"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_7"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_8"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />

            <View
                android:id="@+id/section_right_9"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="#FFCCCCCC" />
        </GridLayout>

    </LinearLayout>

</FrameLayout>
